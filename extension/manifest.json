{
  "manifest_version": 3,
  "name": "FairDeal — Find a deal from a product photo",
  "version": "1.1.0",
  "description": "Detect product pages locally and open FairDeal from a button on the product image. Comparison currently uses fictional demo parkas.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://fairdeal-5h0w.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FairDeal Buyer Agent"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "product.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
