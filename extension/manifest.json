{
  "manifest_version": 3,
  "name": "FairDeal — AI-assisted PayPal checkout",
  "version": "1.0.0",
  "description": "Find a validated package from the FairDeal demo merchant using your submitted budget and delivery preferences.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://fairdeal-5h0w.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FairDeal Buyer Agent"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}