PORT=8080
DB_PATH=./fairdeal.db
PAYPAL_MODE=mock                 # mock | sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=               # optional (US-13)
NASHPAY_HMAC_SECRET=             # >= 32 random bytes (hex)

# AI Negotiation Engine (AI mandate and policy parser)
AI_MODE=llm                      # llm | heuristic
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Reserved Kernel configuration; market verification is currently unavailable
KERNEL_API_URL=https://api.onkernel.com
KERNEL_API_KEY=                  # from https://app.onkernel.com

COMMIT_COOLDOWN_SECONDS=30
DEMO_MODE=1                      # enables POST /api/merchant/demo/reset
# Configure one merchant account; generate the hash with cmd/merchant-access
MERCHANT_EMAIL=
MERCHANT_PASSWORD_HASH=

# Public origin for payment return URLs; Render uses RENDER_EXTERNAL_URL automatically
BASE_URL=

# Five merchant verifier objects, keyed alpine/nordic/glacier/sierra/polaris. No plaintext passwords.
MERCHANTS_JSON=

# Registered Sandbox webhook for /api/paypal/webhook; unavailable until configured.
PAYPAL_WEBHOOK_ID=
